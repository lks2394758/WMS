{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "wms-api",
    "Audience": "wms-clients",
    "AccessTokenMinutes": 15
  },
  "Persistence": {
    "Provider": "Sqlite",
    "Sqlite": {
      "DataSource": "App_Data/wms-demo.db",
      "LockTimeoutSeconds": 10
    }
  },
  "RateLimiting": {
    "PermitLimit": 120,
    "WindowSeconds": 60
  }
}
